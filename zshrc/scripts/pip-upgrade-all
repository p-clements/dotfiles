#!/usr/bin/env bash
# pip-upgrade-all — upgrade every outdated pip package in the current environment
#
# Usage:
#   pip-upgrade-all
#
# Notes:
#   - Operates on whichever python/pip is active (pyenv, venv, system)
#   - Requires jq to parse pip's JSON output (brew install jq / apt install jq)
#   - Run inside a virtual environment to avoid upgrading system packages

set -u

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required (brew install jq or sudo apt install jq)"
  exit 1
fi

py="$(command -v python || command -v python3)" || {
  echo "Python not found (pyenv not initialised or no python installed)."
  exit 1
}

"$py" -m pip list --outdated --format=json \
  | jq -r '.[].name' \
  | xargs -n1 "$py" -m pip install --upgrade
